// Slotty — schema base do MVP
// Modela: usuários (NextAuth-compatible), contas de redes sociais conectadas
// via OAuth, e posts agendados (com suporte a multi-canal e multi-mídia).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  THREADS
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // login por credenciais (NextAuth CredentialsProvider)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relacionamentos de autenticação (NextAuth Prisma Adapter)
  authAccounts AuthAccount[]
  sessions     Session[]

  // Relacionamentos de domínio do Slotty
  socialAccounts SocialAccount[]
  posts          Post[]

  @@map("users")
}

// Contas OAuth do próprio login (Google, GitHub, etc.) — exigido pelo
// NextAuth Prisma Adapter. Não confundir com SocialAccount (redes sociais
// que o usuário conecta para publicar).
model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Conta de rede social conectada pelo usuário (Painel de Conexões).
// Guarda os tokens OAuth necessários para publicar em nome do usuário.
model SocialAccount {
  id           String         @id @default(cuid())
  userId       String
  platform     SocialPlatform
  displayName  String // ex: "@agenciadiniz"
  avatarUrl    String?
  // Alvo da publicação: Page ID (Facebook) ou Instagram Business Account ID.
  // A Meta não permite publicar em perfil pessoal desde a remoção de publish_actions.
  externalId   String?
  accessToken  String         @db.Text
  refreshToken String?        @db.Text
  tokenExpires DateTime?
  isConnected  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts PostChannel[]

  @@unique([userId, platform, displayName])
  @@map("social_accounts")
}

// Um agendamento. Pode ser publicado em vários canais (PostChannel) e
// carregar várias mídias (PostMedia).
model Post {
  id            String     @id @default(cuid())
  userId        String
  content       String     @db.Text
  status        PostStatus @default(DRAFT)
  scheduledFor  DateTime?
  timezone      String     @default("America/Sao_Paulo")
  hashtags      String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  channels PostChannel[]

  @@index([userId, scheduledFor])
  @@map("posts")
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  url       String
  type      MediaType
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_media")
}

// Junção Post <-> SocialAccount: permite status de publicação por canal
// (ex: post falhou só no LinkedIn) e reaproveita o mesmo conteúdo base.
model PostChannel {
  id              String     @id @default(cuid())
  postId          String
  socialAccountId String
  status          PostStatus @default(SCHEDULED)
  publishedAt     DateTime?
  externalPostId  String? // id do post na rede social, após publicado
  errorMessage    String?

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@map("post_channels")
}
