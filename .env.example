# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Social OAuth Credentials (get these from your developer platforms)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"

LINKEDIN_APP_ID="your-linkedin-app-id"
LINKEDIN_APP_SECRET="your-linkedin-app-secret"

THREADS_APP_ID="your-threads-app-id"
THREADS_APP_SECRET="your-threads-app-secret"

# Cron Job Secret
CRON_SECRET="your-cron-secret-here"

# Redis Job Queue (Upstash)
REDIS_URL="redis://default:your-upstash-token@your-upstash-endpoint:6379"
